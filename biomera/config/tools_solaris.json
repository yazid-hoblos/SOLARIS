{
  "tools": [
    {
      "name": "shell",
      "description": "Execute shell commands including SOLARIS bioinformatics tools",
      "parameters": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string",
            "description": "Command to execute"
          }
        },
        "required": ["value"]
      }
    },
    {
      "name": "ask",
      "description": "Ask user for clarification",
      "parameters": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string",
            "description": "Question to ask"
          }
        },
        "required": ["value"]
      }
    },
    {
      "name": "end",
      "description": "Complete the task",
      "parameters": {}
    }
  ],
  
  "solaris": {
    "pathway_profiler": {
      "description": "Analyze pathway coverage in genomes",
      "commands": {
        "workflow": "Full pipeline | --pathway <id> --genome <file> --pfam-db <path>",
        "extract-ec": "Get EC numbers | --pathway <id> --output <file>",
        "get-profiles": "Extract HMMs | --input <file> --pfam-db <path> --output <file>",
        "search": "Search genome | --hmm <file> --genome <file> --output <file>",
        "analyze": "Analyze coverage | --hits <file> --input <file> --output-dir <dir>",
        "visualize": "Create pathway map | --results <csv> --pathway <id>"
      }
    },
    
    "pangenomic_analyzer": {
      "description": "Compare multiple strains",
      "commands": {
        "complete": "Full workflow | --genomes-dir <dir> --hmm-file <file> [--plot]",
        "hmm-analysis": "HMM search only | --genomes-dir <dir> --hmm-file <file>",
        "pathway-analysis": "Analyze results | --results-dir <dir> [--plot]"
      }
    },
    
    "compatibility_predictor": {
      "description": "Find suitable host organisms",
      "commands": {
        "kegg": "Query organisms | --ec-file <file> --output <json>",
        "bacdive": "Filter by conditions | --email <email> --taxonomy <term> --temp-min <n> --temp-max <n>",
        "match": "Cross-reference | --email <email> --kegg-file <json> --bacdive-file <json>"
      }
    }
  },
  
  "examples": [
    "solaris pathway_profiler extract-ec --module M00376 --output ec.txt",
    "solaris pangenomic_analyzer complete --genomes-dir ./genomes --hmm-file pfam.hmm --plot",
    "solaris compatibility_predictor kegg --ec-file ec.txt --output results.json",
    "ls -la",
    "cat ec_numbers.txt"
  ]
}
